        "*.{ts,tsx,js,cjs,mjs}": [
            "tsx scripts/workflow/format-description.ts",
            "oxlint --type-aware --fix",
            "eslint --cache --fix --concurrency auto",
            "oxfmt --no-error-on-unmatched-pattern"
        ],
        "*.yml": [
            "eslint --cache --fix --concurrency auto",
            "oxfmt --no-error-on-unmatched-pattern"
        ]
